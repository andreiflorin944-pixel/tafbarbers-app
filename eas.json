{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.tafbarbers.ro"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.tafbarbers.ro"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826855504"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
