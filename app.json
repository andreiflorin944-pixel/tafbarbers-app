{
  "expo": {
    "name": "TAFBarbers",
    "slug": "tafbarbers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ro.tafbarbers.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ro.tafbarbers.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "tafbarbers",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplicația folosește pozele tale doar ca să le atașezi la profil (de exemplu tunsoarea dorită).",
          "cameraPermission": "Aplicația folosește camera doar ca să faci o poză pentru profil sau pentru frizer."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Aplicația folosește microfonul doar când vorbești cu asistentul TAF."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F9A11B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplicația folosește locația doar ca să te anunțe când ești lângă salon, dacă pornești opțiunea din Contul meu.",
          "locationAlwaysAndWhenInUsePermission": "Aplicația folosește locația doar ca să te anunțe când ești lângă salon, dacă pornești opțiunea din Contul meu. Poziția ta nu e trimisă nicăieri.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "florinflorin",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d5c78da-8145-45f1-bc49-4a055bebea7c"
      }
    }
  }
}
