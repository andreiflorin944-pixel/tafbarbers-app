{
  "expo": {
    "name": "TAFBarbers",
    "slug": "tafbarbers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.tafbarbers.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ro.tafbarbers.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "tafbarbers",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplicația folosește pozele tale doar ca să le atașezi la profil (de exemplu tunsoarea dorită).",
          "cameraPermission": "Aplicația folosește camera doar ca să faci o poză pentru profil sau pentru frizer."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Aplicația folosește microfonul doar când vorbești cu asistentul TAF."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
